"""
BMRB NMR-STAR → SQLite para Metabolômica (apenas 1D ¹H e 600 MHz)
=================================================================
Lê arquivos .str do BMRB e popula um banco bmrb_600mhz.db com:
  - metabolites   (nome do _Entry.Title, sempre)
  - shifts_1h     (deslocamentos ¹H, multiplicidade, J)
  - transitions   (picos de alta resolução, opcional)
  - samples       (condições experimentais)

Apenas entradas com experimentos 1D ¹H e campo magnético 600 MHz são inseridas.
Multipletos (m, br m, …) são excluídos da tabela shifts_1h.
Para picos sem atribuição, cria nomes sintéticos "peak_<id>".
"""

import os
import re
import sqlite3
import logging
from pathlib import Path

# ─── CONFIGURAÇÃO ──────────────────────────────────────────────────────────────
INPUT_DIR         = r"C:\Users\migue\OneDrive\Documentos\bmrb_entries"
OUTPUT_DB         = r"C:\Users\migue\OneDrive\Documentos\bmrb_600mhz_042526.db"
TARGET_FIELD_MHZ  = 600
LOG_LEVEL         = logging.INFO          # troque para logging.DEBUG para mais detalhes
# ───────────────────────────────────────────────────────────────────────────────

logging.basicConfig(
    level=LOG_LEVEL,
    format="%(levelname)s | %(message)s",
)
log = logging.getLogger(__name__)

# Multiplicidades aceites e as que devem ser excluídas (multipletos)
VALID_MULT = {"s", "d", "t", "q", "dd", "dt", "td", "tt", "dq", "qt",
              "sept", "sext", "br s", "br d", "br t"}
EXCLUDED_MULT = {"m", "br m", "multiplet", "unresolved", "br", "broad"}


# ═══════════════════════════════════════════════════════════════════════════════
#  UTILITÁRIOS DE LEITURA NMR-STAR
# ═══════════════════════════════════════════════════════════════════════════════

def read_file(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return path.read_text(encoding="latin-1")


def normalize(val: str | None) -> str | None:
    """Limpa a string: remove aspas, ';', espaços e valores nulos."""
    if val is None:
        return None
    val = val.strip().strip("'\"\n\r\t ;")
    if val in (".", "?", ""):
        return None
    return val


def to_float(val: str | None) -> float | None:
    try:
        return float(val) if val not in (None, ".", "?", "") else None
    except (ValueError, TypeError):
        return None


def to_int(val: str | None) -> int | None:
    try:
        return int(float(val)) if val not in (None, ".", "?", "") else None
    except (ValueError, TypeError):
        return None


def get_tag(text: str, tag: str) -> str | None:
    """
    Procura uma tag simples seguida de valor (entre aspas ou palavra simples).
    """
    pattern = re.compile(
        r'(?:^|\s)' + re.escape(tag) + r'\s+'
        r"(?:'([^']*)'|\"([^\"]*)\"|(\S+))",
        re.MULTILINE | re.IGNORECASE,
    )
    m = pattern.search(text)
    if not m:
        return None
    val = m.group(1) or m.group(2) or m.group(3)
    return normalize(val)


def get_tag_multiline(text: str, tag: str) -> str | None:
    """
    Procura uma tag seguida de uma string multi‑linha delimitada por ';'.
    Exemplo: _Entry.Title\n;D_fructose_6_phosphate\n;
    """
    pattern = re.compile(
        r'(?:^|\n)\s*' + re.escape(tag) + r'\s*\n;(.*?)\n;',
        re.DOTALL | re.IGNORECASE,
    )
    m = pattern.search(text)
    if not m:
        return None
    return normalize(m.group(1))


def get_save_blocks(text: str) -> dict[str, str]:
    blocks: dict[str, str] = {}
    pattern = re.compile(r'save_(\S+)(.*?)(?=save_|\Z)', re.DOTALL)
    for m in pattern.finditer(text):
        name = m.group(1).strip()
        content = m.group(2)
        blocks[name] = content
    return blocks


def parse_loop(block: str, prefix: str) -> list[dict[str, str]]:
    """
    Extrai listas de dicionários de loops NMR-STAR.
    """
    loop_pattern = re.compile(
        r'loop_\s+((?:\s*' + re.escape(prefix) + r'\S+\s*)+)(.*?)(?=loop_|save_|\Z)',
        re.DOTALL | re.IGNORECASE,
    )
    results = []
    for lm in loop_pattern.finditer(block):
        header_text = lm.group(1)
        data_text   = lm.group(2)

        cols = re.findall(re.escape(prefix) + r'(\S+)', header_text, re.IGNORECASE)
        if not cols:
            continue

        tokens = tokenize_nmrstar(data_text)
        n = len(cols)
        for i in range(0, len(tokens) - n + 1, n):
            row = {cols[j]: normalize(tokens[i + j]) for j in range(n)}
            results.append(row)
    return results


def tokenize_nmrstar(text: str) -> list[str]:
    """
    Tokeniza dados NMR-STAR, tratando strings entre aspas e multiline strings.
    """
    tokens = []
    text = re.sub(r'#.*', '', text)
    text = re.sub(r'\n;(.*?)\n;', lambda m: f"'{m.group(1).strip()}'", text, flags=re.DOTALL)
    pattern = re.compile(r"'[^']*'|\"[^\"]*\"|\S+")
    for m in pattern.finditer(text):
        tok = m.group(0)
        if tok.lower() in ("loop_", "stop_", "save_"):
            break
        tokens.append(tok)
    return tokens


