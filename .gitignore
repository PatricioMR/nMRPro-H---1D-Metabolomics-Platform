# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Virtual environment ─────────────────────────────────────────────────────
venv/
.venv/
env/

# ── IDE / editor ────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Local-only (utilities, examples, scratch — not part of the running app) ──
_local/

# ── Runtime-generated ───────────────────────────────────────────────────────
logs/
*.log

# ── Build / distribution artifacts (rebuilt locally, never committed) ───────
build/
dist/
Output/
*.exe
*.zip

# ── Database backups / superseded versions (keep only the active *.db) ──────
databases/backup_*/
databases/*.bak*

# ── Raw reference dumps (re-downloadable build inputs, not source) ───────────
# ChEBI ontology/structure dumps used only to build the metabolite DBs; large
# binaries that must not bloat git history.
hmdb_api_download/chebi/*.gz

# ── Local config / scratch ──────────────────────────────────────────────────
/settings.json
*.tmp
.DS_Store

# ── Excluded from VCS by request (kept locally) ─────────────────────────────
.claude/
/CLAUDE.md
/pytest.ini
/run_tests.bat
/ParseHMDBNames.py
.tmp.driveupload/

# Working notes, not part of the repo
PENDENCIAS.md

# Google Drive conflict copies. It duplicates a whole folder as "data (1)/"
# when it cannot reconcile a change, and two of those got committed once.
* (1)/
* (2)/
* (1).*
* (2).*
databases/bmrb_fids/
hmdb_api_download/_fid_download.log
hmdb_api_download/_fid_errors.log
hmdb_api_download/_v02_disagreements.csv
databases/BMRB_Metabolomics_v02.db
validation/out/

# v06 build: HMDB bulk index cache (~170 MB), rebuilt from NMR Databases/hmdb_bulk
hmdb_api_download/_hmdb_v06_index.json

# ── Reference-library build downloads (re-fetched by hmdb_api_download/download_*.py
#    with HMDB_API_KEY set; inputs of the build, not source) ──────────────────
hmdb_api_download/nmr/
hmdb_api_download/ontology/
hmdb_api_download/base/
hmdb_api_download/hmdb_index.db*
hmdb_api_download/_probe_*.json
hmdb_api_download/_pw_*.json
hmdb_api_download/_pg1.json
hmdb_api_download/_schema.*
hmdb_api_download/_errors.log
hmdb_api_download/_progress.log

# ── Local scratch at the repo root ──────────────────────────────────────────
/build_out.txt
/p.html
/nmrpro_h (*).spec
# Intermediate libraries of the build (v01) and its validation output: rebuilt
# by the scripts, never shipped (the app offers app_paths.REFERENCE_DATABASES).
databases/*_v01.db
hmdb_api_download/_pattern_fit_validation.csv
