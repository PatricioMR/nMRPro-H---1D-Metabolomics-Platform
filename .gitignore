# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Virtual environment ─────────────────────────────────────────────────────
venv/
.venv/
env/

# ── IDE / editor ────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Local-only (utilities, examples, scratch — not part of the running app) ──
_local/

# ── Runtime-generated ───────────────────────────────────────────────────────
logs/
*.log

# ── Database backups / superseded versions (keep only the active *.db) ──────
databases/backup_*/
databases/*.bak*

# ── Local config / scratch ──────────────────────────────────────────────────
/settings.json
*.tmp
.DS_Store

# ── Excluded from VCS by request (kept locally) ─────────────────────────────
.claude/
/CLAUDE.md
/pytest.ini
/run_tests.bat
/ParseHMDBNames.py
